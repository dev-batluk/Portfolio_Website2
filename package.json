{
  "name": "nevermind-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node server/dev.ts",
    "dev:api": "tsc -p tsconfig.server.json && node dist-server/server/index.js --port 3001 --api-only",
    "dev:web": "vite",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "tsc -p tsconfig.server.json && node dist-server/server/index.js",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -b && tsc -p tsconfig.server.json --noEmit && vite build",
    "preview": "tsc -p tsconfig.server.json && node dist-server/server/index.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "gsap": "^3.12.7",
    "lenis": "^1.1.20",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^26.6.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
