# NEVERMIND Server Configuration
PORT=4173
HOST=127.0.0.1

# Admin Console Credentials (NEVER expose in frontend code)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Optional: custom session signing secret across serverless instances
# SESSION_SECRET=replace-with-random-secret
# Optional: pre-hashed password in format scrypt$<saltHex>$<hashHex>
# ADMIN_PASSWORD_HASH=

# Optional Postgres URL (e.g. Neon Postgres on Vercel Storage).
# If omitted, uses local SQLite (./data/nevermind.sqlite or /tmp/nevermind.sqlite on Vercel)
# DATABASE_URL=
# SQLITE_PATH=./data/nevermind.sqlite

# Auto-purge completed orders older than N days (default: 30)
ORDER_RETENTION_DAYS=30

# Secret for Vercel Scheduled Cron (/api/cleanup-orders)
# CRON_SECRET=replace-with-random-secret
